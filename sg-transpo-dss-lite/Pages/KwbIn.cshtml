@page "/KwbIn"
@model KwbInModel
@using sg_transpo_rcl.Components
@using ss_transpo_dss.services.Models.Responses
@using static ss_transpo_dss.services.Globals.KwbRouteDirections
@inject IHtmlHelper HtmlHelper

@{
    ViewData["Title"] = $"Kingsford Waterbay ({INCOMING})";
    Model.DecisionResponses.TryGetValue(INCOMING, out DecisionResponse result);
}

<div class="text-center">
    <h5 class="display-6">Kingsford Waterbay (@INCOMING):</h5>
    <br />
    <partial name="_KwbArrivalsPartial" model="result" />
</div>
